{
  "name": "@logger/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/bot/src/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "commands:register": "tsx src/register-commands.ts"
  },
  "dependencies": {
    "@logger/db": "workspace:*",
    "@logger/shared": "workspace:*",
    "bullmq": "latest",
    "discord.js": "latest",
    "ioredis": "5.10.1",
    "pino": "latest"
  },
  "devDependencies": {
    "tsx": "latest"
  }
}
