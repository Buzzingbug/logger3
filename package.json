{
  "name": "logger-bot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:bot": "pnpm --filter @logger/bot dev",
    "dev:web": "pnpm --filter @logger/web dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @logger/db db:generate",
    "db:migrate": "pnpm --filter @logger/db db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:worker": "pnpm --filter @logger/worker dev",
    "worker:start": "pnpm --filter @logger/worker start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "latest",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript": "latest",
    "typescript-eslint": "^8.62.1"
  }
}
